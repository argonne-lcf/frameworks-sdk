# 2) Set PyTorch build configuration
export WERROR=0
export REL_WITH_DEB_INFO=1
export USE_CUDA=0
export USE_ROCM=0
export USE_MKLDNN=1
export USE_MKL=1
export USE_CUDNN=0
export USE_FBGEMM=1
